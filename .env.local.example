# ── Supabase (공개 키만. service_role 키는 절대 넣지 않아요) ──
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# ── Google AdSense (비워 두면 광고가 안 나와요. 개발 중에는 점선 자리표시자가 보여요) ──
# 애드센스 승인 후 발급받은 값으로 바꿔요. 형식: ca-pub- 뒤에 숫자 16자리 안팎
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-XXXXXXXXXXXXXXXX
# 광고 단위(슬롯) ID — 숫자만. 메인 목록 중간용 / 공연 상세 하단용
NEXT_PUBLIC_ADSENSE_SLOT_LIST=0000000000
NEXT_PUBLIC_ADSENSE_SLOT_DETAIL=0000000000

# 선택: 사이트 주소(링크 미리보기용). 비우면 Vercel이 넣어 주는 주소를 써요.
# NEXT_PUBLIC_SITE_URL=https://내주소.vercel.app
